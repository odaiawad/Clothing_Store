{
  "name": "creative-marketing-website",
  "version": "1.0.0",
  "description": "موقع ويب حديث لشركة تسويق وتصميم باللغة العربية مع دعم RTL",
  "main": "index.html",
  "scripts": {
    "start": "live-server --port=8080 --host=localhost --open=/",
    "dev": "live-server --port=3000 --host=localhost",
    "build": "npm run minify-css && npm run minify-js",
    "minify-css": "cleancss -o styles.min.css styles.css",
    "minify-js": "uglifyjs script.js -o script.min.js -c -m",
    "validate-html": "html-validate index.html",
    "test": "echo \"تم تطوير الموقع وهو جاهز للاستخدام\" && exit 0"
  },
  "keywords": [
    "arabic",
    "rtl",
    "website",
    "marketing",
    "design",
    "responsive",
    "modern",
    "portfolio"
  ],
  "author": "Creative Marketing Agency",
  "license": "MIT",
  "devDependencies": {
    "live-server": "^1.2.2",
    "clean-css-cli": "^5.6.2",
    "uglify-js": "^3.17.4",
    "html-validate": "^8.7.4"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/username/creative-marketing-website.git"
  },
  "bugs": {
    "url": "https://github.com/username/creative-marketing-website/issues"
  },
  "homepage": "https://github.com/username/creative-marketing-website#readme"
}